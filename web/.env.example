# Copiar para .env.local depois de criar o projeto Supabase.
# Estes dois valores são próprios para utilização no cliente.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUIR

# Nunca adicionar SUPABASE_SECRET_KEY ou service_role a variáveis NEXT_PUBLIC_*.

# Opcional: fallback privado no servidor para páginas sem receita estruturada.
# Criar em https://aistudio.google.com/apikey e nunca prefixar com NEXT_PUBLIC_.
GEMINI_API_KEY=COLE_A_CHAVE_AQUI
